# macOS cruft
.DS_Store

# Generated by XcodeGen — project.yml is the only structure truth.
# Run `make generate` after cloning; see CONTRIBUTING.md.
*.xcodeproj
Generated/

# Build outputs
.build/
build/
DerivedData/
*.xcresult

# Profiling output (scripts/profile.sh writes here; traces are reproducible, not source)
traces/

# Mutation testing (muter) scratch
.muter/

# Signing credentials. Never commit these. docs/distribution.md explains where
# they belong instead. This is a backstop, not a control: the notarytool command
# in older docs read authkey.p8 from the working directory, which is how a key
# ends up in a commit.
*.p12
*.p8
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
*.key
AuthKey_*
authkey*
